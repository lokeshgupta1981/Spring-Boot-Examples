<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example of a Logback file for things application.properties cannot do:
  a second file that receives only ERROR events.
  Rename it to logback-spring.xml to make Spring Boot load it automatically,
  or keep the name and start the app with logging.config=classpath:logback-errors-spring.xml
-->
<configuration>
  <!-- Spring Boot defaults: CONSOLE and FILE appenders, logging.* properties still work -->
  <include resource="org/springframework/boot/logging/logback/base.xml"/>

  <appender name="ERRORS" class="ch.qos.logback.core.FileAppender">
    <file>logs/errors.log</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.howtodoinjava">
    <appender-ref ref="ERRORS"/>
  </logger>
</configuration>
